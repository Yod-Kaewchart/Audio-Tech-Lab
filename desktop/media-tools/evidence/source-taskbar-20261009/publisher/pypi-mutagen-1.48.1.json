{"info":{"author":null,"author_email":"Christoph Reiter <reiter.christoph@gmail.com>","bugtrack_url":null,"classifiers":["Operating System :: OS Independent","Programming Language :: Python :: 3","Programming Language :: Python :: Implementation :: CPython","Programming Language :: Python :: Implementation :: PyPy","Topic :: Multimedia :: Sound/Audio"],"description":".. image:: https://raw.githubusercontent.com/quodlibet/mutagen/main/docs/images/logo.svg\n   :align: center\n   :width: 400px\n\n|\n\nMutagen is a Python module to handle audio metadata. It supports ASF, FLAC,\nMP4, Monkey's Audio, MP3, Musepack, Ogg Opus, Ogg FLAC, Ogg Speex, Ogg Theora,\nOgg Vorbis, True Audio, WavPack, OptimFROG, and AIFF audio files. All\nversions of ID3v2 are supported, and all standard ID3v2.4 frames are parsed.\nIt can read Xing headers to accurately calculate the bitrate and length of\nMP3s. ID3 and APEv2 tags can be edited regardless of audio format. It can also\nmanipulate Ogg streams on an individual packet/page level.\n\nMutagen works with Python 3.10+ (CPython and PyPy) on Linux, Windows and macOS,\nand has no dependencies outside the Python standard library. Mutagen is licensed\nunder `the GPL version 2 or\nlater <https://spdx.org/licenses/GPL-2.0-or-later.html>`__.\n\nFor more information visit https://mutagen.readthedocs.org\n\n.. image:: https://codecov.io/gh/quodlibet/mutagen/branch/main/graph/badge.svg\n  :target: https://codecov.io/gh/quodlibet/mutagen\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":["License-File"],"home_page":null,"keywords":null,"license":null,"license_expression":"GPL-2.0-or-later","license_files":["COPYING"],"maintainer":null,"maintainer_email":null,"name":"mutagen","package_url":"https://pypi.org/project/mutagen/","platform":null,"project_url":"https://pypi.org/project/mutagen/","project_urls":{"Homepage":"https://mutagen.readthedocs.io","Repository":"https://github.com/quodlibet/mutagen"},"provides_extra":null,"release_url":"https://pypi.org/project/mutagen/1.48.1/","requires_dist":null,"requires_python":"<4,>=3.10","summary":"read and write audio tags for many formats","version":"1.48.1","yanked":false,"yanked_reason":null},"last_serial":38382646,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"lazka"},{"role":"Owner","user":"phw"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"cd882f5f900d6d0ef2951b0c9898d14b6ab881fda89b924dbebbe12441f94118"},"digests":{"blake2b_256":"47d8a29e4e3991765e7ce4ed1f7e4074fe1ba9da03e0048639734de60f9cadb9","md5":"dfc18cc497f1ec86290f266af85db612","sha256":"4f077fe87d3fc7fba259aa63d8c026b18382ca6a42ef37c61e16f1b1b5b82fe7"},"downloads":-1,"filename":"mutagen-1.48.1-py3-none-any.whl","has_sig":false,"md5_digest":"dfc18cc497f1ec86290f266af85db612","packagetype":"bdist_wheel","python_version":"py3","requires_python":"<4,>=3.10","size":195706,"upload_time":"2026-06-25T09:47:30","upload_time_iso_8601":"2026-06-25T09:47:30.296285Z","url":"https://files.pythonhosted.org/packages/47/d8/a29e4e3991765e7ce4ed1f7e4074fe1ba9da03e0048639734de60f9cadb9/mutagen-1.48.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"df701675da133ea92227da41bf5b24e1c66be597ff736a1533ade41da986852f","md5":"90d74b6da76fdf31933766e0e0d83cc5","sha256":"8f95637ab9f6f305cec6bd1294e197debe207998e3e068596563c74f86b0a173"},"downloads":-1,"filename":"mutagen-1.48.1.tar.gz","has_sig":false,"md5_digest":"90d74b6da76fdf31933766e0e0d83cc5","packagetype":"sdist","python_version":"source","requires_python":"<4,>=3.10","size":1276978,"upload_time":"2026-06-25T09:47:32","upload_time_iso_8601":"2026-06-25T09:47:32.443972Z","url":"https://files.pythonhosted.org/packages/df/70/1675da133ea92227da41bf5b24e1c66be597ff736a1533ade41da986852f/mutagen-1.48.1.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}
